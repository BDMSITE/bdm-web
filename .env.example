# Béninois du Monde — variables d'environnement
# Copier en .env pour le dev local (valeurs ci-dessous = docker compose).
# En prod/préprod : Vercel → Settings → Environment Variables.

# Base de données (Postgres local via docker compose, port 5433 ; Neon en prod)
DATABASE_URL="postgresql://bdm:bdm@localhost:5433/bdm"

# Auth.js — générer : openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# E-mails transactionnels (Resend) — vide en dev : les e-mails sont loggés en console
RESEND_API_KEY=""
EMAIL_FROM="Béninois du Monde <no-reply@localhost>"

# Recherche (Meilisearch local via docker compose)
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev-master-key"

# Cartes (MapTiler) — vide en dev : fond OpenStreetMap
NEXT_PUBLIC_MAPTILER_KEY=""

# S6 — newsletter et paiements
BREVO_API_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
