# Béninois du Monde — variables d'environnement
# Copier en .env pour le dev local (valeurs ci-dessous = docker compose).
# En prod/préprod : Vercel → Settings → Environment Variables.

# Base de données (Postgres local via docker compose, port 5433 ; Neon en prod)
DATABASE_URL="postgresql://bdm:bdm@localhost:5433/bdm"

# Auth.js — générer : openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# E-mails transactionnels — Brevo (gratuit, envoie sans domaine) de préférence, sinon Resend.
# Les deux vides en dev : les e-mails sont affichés dans la console du serveur.
BREVO_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Béninois du Monde <no-reply@localhost>"
# Destinataire du formulaire de contact (sinon EMAIL_FROM)
CONTACT_EMAIL=""

# Recherche (Meilisearch local via docker compose)
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev-master-key"

# Cartes (MapTiler) — vide en dev : fond OpenStreetMap
NEXT_PUBLIC_MAPTILER_KEY=""

# Adhésions HCBE — FedaPay (sandbox : clés pk_sandbox_… / sk_sandbox_… ; live : pk_live_… / sk_live_…).
# Vides = pas de paiement en ligne (activation manuelle dans Admin → Adhésions).
# Webhook à déclarer dans FedaPay → Workbench → Webhooks : https://<site>/api/fedapay/webhook ; son secret ci-dessous.
# La clé publique est transmise au widget Checkout.js par la page de paiement (pas de préfixe NEXT_PUBLIC_ nécessaire).
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# S7 — sécurité et fichiers
# Jeton du Blob privé Vercel (CV déposés, sauvegardes) : créé par `vercel blob create-store`
BLOB_READ_WRITE_TOKEN=""
# Secret du cron de sauvegarde (Vercel l'envoie en Authorization: Bearer) : openssl rand -hex 32
CRON_SECRET=""
# Anti-robot Cloudflare Turnstile (gratuit). Vides = vérification désactivée.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Réseaux sociaux (affichés seulement si renseignés)
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_WHATSAPP=""
# (ou saisir ces liens dans Admin → Paramètres → Réseaux sociaux, prioritaire)
