// Béninois du Monde — schéma v0 (draft, CDC §8)
// Principe : un contenu = une entité générique Content, typée, géolocalisée, taguée.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EDITOR
  MODERATOR
  REGIE
  ADMIN
}

enum AccountType {
  MEMBER
  COMPANY
  ASSOCIATION
  ARTIST
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentType {
  ARTICLE
  MEMBER_ARTICLE
  JOB
  INTERNSHIP
  EVENT
  CLASSIFIED
  PLACE
  DEAL
  HELP_REQUEST
  MEMORY_PLACE
}

enum ContentStatus {
  DRAFT
  IN_MODERATION
  SCHEDULED
  PUBLISHED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum KeywordFamily {
  SECTOR
  PLACE
  THEME
}

/* Compétences de la diaspora : un membre propose son expertise, le HCBE valide. */
enum ExpertStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/* Accueil & hébergement : type d'accueil proposé par un membre. */
enum HostingKind {
  ROOM
  WHOLE
  FAMILY
}

enum AlertFrequency {
  INSTANT
  DAILY
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role        @default(USER)
  accountType   AccountType @default(MEMBER)
  status        UserStatus  @default(PENDING_EMAIL)
  invitedAt     DateTime?   // dernier e-mail d'invitation (comptes importés)
  importedFrom  String?     // source de l'import (ex. "excel-hcbe-2026-10")
  twoFactorSecret String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  profile      Profile?
  accounts     Account[]
  sessions     Session[]
  alerts       Alert[]
  applications Application[]
  messagesSent Message[]     @relation("MessageFrom")
  reports      Report[]
  auditLogs    AuditLog[]
  favorites    Favorite[]
  messagesReceived Message[] @relation("MessageToUser")
  blocks       UserBlock[]   @relation("Blocker")
  blockedBy    UserBlock[]   @relation("Blocked")
}

// --- Auth.js (comptes OAuth futurs, sessions, jetons de lien magique) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  slug           String   @unique
  photo          String?
  headline       String?  // fonction / profession affichée
  phone          String?  // privé : jamais affiché, usage HCBE
  bio            String?
  country        String?
  city           String?
  lat            Float?
  lng            Float?
  website        String?
  socials        Json?
  visibility     Json? // par champ : public | members | private
  cvUrl          String?
  cvPublished    Boolean  @default(false)
  publishedCount Int      @default(0)
  expertStatus   ExpertStatus @default(NONE)
  expertDomain   String?  // domaine principal (Santé, Numérique, Droit & finance…)
  expertModes    Json?    // ["MENTORAT","MISSION","CONSEIL"]
  expertPitch    String?  // ce que le membre propose, relu par le HCBE
  expertAt       DateTime? // date de la demande ou de la décision
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company     CompanyDetails?
  association AssociationDetails?
  artist      ArtistDetails?
  banners     Banner[]
  contents    Content[]           @relation("OwnerProfile")
  keywords    ProfileKeyword[]
  messages    Message[]           @relation("MessageTo")
  partner     Partner?
  hosting     HostingOffer?
}

/* Fiche d'accueil d'un membre (CDC §7.10) : relue par le HCBE avant publication,
   jamais de coordonnées publiées, mise en relation par la messagerie relais. */
model HostingOffer {
  id         String        @id @default(cuid())
  profileId  String        @unique
  profile    Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind       HostingKind
  audience   Json          // ["ETUDIANT","VISITEUR","AFRODESCENDANT"]
  city       String
  country    String
  capacity   Int?
  duration   String?       // « quelques nuits », « un semestre »…
  conditions String        // participation, règles de la maison
  status     ContentStatus @default(IN_MODERATION)
  charterAt  DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, country])
}

model CompanyDetails {
  profileId String  @id
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  size      String?
  sector    String?
}

model AssociationDetails {
  profileId    String  @id
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  purpose      String?
  foundedYear  Int?
  membersCount Int?
}

model ArtistDetails {
  profileId  String  @id
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  discipline String?
}

model Content {
  id             String        @id @default(cuid())
  type           ContentType
  title          String
  slug           String        @unique
  excerpt        String?
  body           String?
  cover          String?
  country        String?
  city           String?
  lat            Float?
  lng            Float?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  expiresAt      DateTime?
  featured       Boolean       @default(false)
  sponsored      Boolean       @default(false)
  views          Int           @default(0)
  moderationNote String?       // motif de refus, transmis à l'auteur
  ownerProfileId String?
  ownerProfile   Profile?      @relation("OwnerProfile", fields: [ownerProfileId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  job          JobDetails?
  event        EventDetails?
  classified   ClassifiedDetails?
  place        PlaceDetails?
  deal         DealDetails?
  keywords     ContentKeyword[]
  applications Application[]
  reports      Report[]
  favorites    Favorite[]
  messages     Message[]

  @@index([type, status, publishedAt])
  @@index([country, city])
}

model JobDetails {
  contentId    String  @id
  content      Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contractType String // CDI, CDD, stage, alternance, volontariat, freelance, mission
  salary       String?
  applyMode    String // link | relay_email | form
  applyTarget  String?
}

model EventDetails {
  contentId String   @id
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime?
  timezone  String   @default("Africa/Porto-Novo") // fuseau du lieu : l'heure saisie est celle du lieu
  isOnline  Boolean  @default(false)
  venue     String?
  ticketUrl String?
  category  String?
}

model ClassifiedDetails {
  contentId String  @id
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category  String // auto-moto, bonnes-affaires, colocation, covoiturage, locations, services, rencontres
  price     String?
  photos    Json?
}

model PlaceDetails {
  contentId String  @id
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category  String
  address   String?
  phone     String?
  hours     String?
  verified  Boolean @default(false)
}

model DealDetails {
  contentId String    @id
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  promoCode String?
  conditions String?
  validFrom DateTime?
  validTo   DateTime?
  clicks    Int       @default(0)
}

model Keyword {
  id       String        @id @default(cuid())
  name     String
  slug     String        @unique
  family   KeywordFamily
  parentId String?
  parent   Keyword?      @relation("KeywordTree", fields: [parentId], references: [id])
  children Keyword[]     @relation("KeywordTree")
  contents ContentKeyword[]
  profiles ProfileKeyword[]
}

model ContentKeyword {
  contentId String
  keywordId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([contentId, keywordId])
}

model ProfileKeyword {
  profileId String
  keywordId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([profileId, keywordId])
}

model Alert {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywordIds   Json
  contentTypes Json
  frequency    AlertFrequency @default(DAILY)
  lastSentAt   DateTime?
  createdAt    DateTime       @default(now())
}

model Application {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvUrl     String?
  message   String?
  status    String   @default("sent")
  createdAt DateTime @default(now())

  @@unique([contentId, userId])
}

model Message {
  id          String   @id @default(cuid())
  fromUserId  String
  from        User     @relation("MessageFrom", fields: [fromUserId], references: [id])
  toProfileId String
  to          Profile  @relation("MessageTo", fields: [toProfileId], references: [id])
  toUserId    String?
  toUser      User?    @relation("MessageToUser", fields: [toUserId], references: [id])
  contentId   String?
  content     Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Message? @relation("Thread", fields: [parentId], references: [id])
  replies     Message[] @relation("Thread")
  body        String
  readAt      DateTime?
  status      String   @default("sent")
  createdAt   DateTime @default(now())

  @@index([toProfileId, createdAt])
  @@index([fromUserId, createdAt])
}

/* Représentations du Bénin à l'étranger, saisies dans l'admin (page HCBE, pages pays). */
model Consulate {
  id        String   @id @default(cuid())
  country   String   // pays couvert (nom normalisé)
  city      String
  kind      String   // AMBASSADE | CONSULAT | CONSULAT_HONORAIRE | MISSION
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  hours     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
}

/* Un membre en bloque un autre : plus de message relais possible dans ce sens. */
model UserBlock {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model Favorite {
  userId    String
  contentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, contentId])
}

model Report {
  id         String   @id @default(cuid())
  contentId  String?
  content    Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())
}

/* Régie publicitaire. Une campagne = un emplacement (format fixe), un visuel
   (image fournie) ou une carte générée (logo + accroche + couleur), un lien,
   une période, un poids de rotation. Les campagnes « maison » (house) tournent
   quand aucune campagne vendue n'est active : un emplacement n'est jamais vide. */
enum BannerSlot {
  TOP // bandeau haut de rubrique 970×90 (mobile 320×100)
  SIDE // pavé latéral 300×250
  MID // pavé milieu accueil 728×90
  BOTTOM // bannière bas de page 970×90
}

enum BannerKind {
  IMAGE // visuel fourni par l'annonceur
  CARD // carte générée : logo + accroche + couleur
}

enum BannerStatus {
  DRAFT
  IN_MODERATION
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Banner {
  id          String       @id @default(cuid())
  title       String // nom interne de la campagne
  advertiser  String // nom affiché de l'annonceur
  profileId   String? // annonceur membre (libre-service)
  profile     Profile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)
  slot        BannerSlot
  kind        BannerKind   @default(CARD)
  image       String? // IMAGE : visuel bureau ; CARD : logo
  imageMobile String?
  photo       String? // CARD : photo d'ambiance en fond
  alt         String
  headline    String? // CARD
  tagline     String? // CARD
  cta         String? // CARD : texte du bouton (défaut « Découvrir »)
  bg          String? // CARD : fond (hex)
  fg          String? // CARD : texte (hex)
  link        String
  house       Boolean      @default(false)
  status      BannerStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime?
  weight      Int          @default(1)
  sections    String[]     @default([]) // rubriques ciblées (vide = toutes)
  countries   String[]     @default([]) // pays du lecteur (vide = tous)
  impressions Int          @default(0)
  clicks      Int          @default(0)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stats       BannerStat[]

  @@index([slot, status, startsAt, endsAt])
}

model BannerStat {
  bannerId    String
  banner      Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@id([bannerId, day])
}

model Partner {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String // rh | annonceur | avantages
  plan      String?
  startsAt  DateTime
  endsAt    DateTime?
}

model Celebrity {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  photo  String?
  domain String?
  bio    String?
  links  Json?
}

model NewsletterIssue {
  id         String    @id @default(cuid())
  subject    String
  intro      String?
  contentIds Json
  sentAt     DateTime?
  stats      Json?
}

model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmedAt DateTime?
  segments    Json?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

model RateLimit {
  key         String   @id // ex. "login:1.2.3.4", "register:email@x"
  windowStart DateTime
  count       Int      @default(1)
}

/* Réglages du site modifiables depuis Paramètres (réseaux sociaux, coordonnées…),
   sans redéploiement. Clé = identifiant stable, valeur = texte. */
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
